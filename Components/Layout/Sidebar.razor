@using System.Security.Claims
@using Apiary.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<nav id="sidebar" class="sidebar">
    <div class="sidebar-header">
        <a href="/" class="sidebar-brand">
            <span class="brand-icon">
                <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16 2L28 9V23L16 30L4 23V9L16 2Z" fill="url(#honeycomb-gradient)" stroke="#a67235" stroke-width="1.5"/>
                    <path d="M16 8L22 11.5V18.5L16 22L10 18.5V11.5L16 8Z" fill="#F5F5F0" stroke="#a67235" stroke-width="1"/>
                    <circle cx="16" cy="15" r="2.5" fill="#c9944a"/>
                    <defs>
                        <linearGradient id="honeycomb-gradient" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#e3b97a"/>
                            <stop offset="1" stop-color="#c9944a"/>
                        </linearGradient>
                    </defs>
                </svg>
            </span>
            <span class="brand-text">Apiary</span>
        </a>
        <button class="sidebar-toggle d-lg-none" type="button" onclick="toggleSidebar()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="sidebar-section-label">Main</div>
    <ul class="sidebar-nav">
        <li class="nav-item">
            <a class="nav-link @(IsActive("Home") ? "active" : "")" href="/">
                <span class="nav-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="9" rx="1"/>
                        <rect x="14" y="3" width="7" height="5" rx="1"/>
                        <rect x="14" y="12" width="7" height="9" rx="1"/>
                        <rect x="3" y="16" width="7" height="5" rx="1"/>
                    </svg>
                </span>
                <span class="nav-text">Dashboard</span>
            </a>
        </li>

        @if (IsSiteAdmin)
        {
            <li class="nav-item">
                <a class="nav-link @(IsActive("Schools") ? "active" : "")" href="/Schools">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18"/>
                            <path d="M5 21V7l7-4 7 4v14"/>
                            <path d="M9 21v-4h6v4"/>
                            <path d="M10 10h4"/>
                            <path d="M12 10v4"/>
                        </svg>
                    </span>
                    <span class="nav-text">Schools</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(IsActiveUsers() ? "active" : "")" href="/Users">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                            <circle cx="17" cy="7" r="3"/>
                            <path d="M21 21v-2a3 3 0 0 0-2-2.83"/>
                        </svg>
                    </span>
                    <span class="nav-text">Users</span>
                </a>
            </li>
        }
        else if (IsTeacher)
        {
            <li class="nav-item">
                <a class="nav-link @(IsActive("Students") ? "active" : "")" href="/Students">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/>
                        </svg>
                    </span>
                    <span class="nav-text">Students</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(IsActive("Companies") ? "active" : "")" href="/Companies">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                            <path d="M12 12v.01"/>
                            <path d="M2 12h20"/>
                        </svg>
                    </span>
                    <span class="nav-text">Companies</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(IsActive("Placements") ? "active" : "")" href="/Placements">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                            <rect x="8" y="2" width="8" height="4" rx="1"/>
                            <path d="M9 14l2 2 4-4"/>
                        </svg>
                    </span>
                    <span class="nav-text">Placements</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(IsActive("Supervisors") ? "active" : "")" href="/Supervisors">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M20 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M4 21v-2a4 4 0 0 1 3-3.87"/>
                            <path d="M12 14c-3.5 0-6 1.5-6 4v2h12v-2c0-2.5-2.5-4-6-4z"/>
                            <path d="M15 6l2 2"/>
                            <path d="M17 4l-2 2"/>
                        </svg>
                    </span>
                    <span class="nav-text">Supervisors</span>
                </a>
            </li>
        }
        else if (IsStudent)
        {
            <li class="nav-item">
                <a class="nav-link @(IsActive("StudentPortal") ? "active" : "")" href="/StudentPortal">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="9" rx="1"/>
                            <rect x="14" y="3" width="7" height="5" rx="1"/>
                            <rect x="14" y="12" width="7" height="9" rx="1"/>
                            <rect x="3" y="16" width="7" height="5" rx="1"/>
                        </svg>
                    </span>
                    <span class="nav-text">My Dashboard</span>
                </a>
            </li>
        }
    </ul>

    <div class="sidebar-footer">
        <div class="sidebar-section-label">Account</div>
        <ul class="sidebar-nav">
            <li class="nav-item">
                <a class="nav-link @(IsActiveProfile() ? "active" : "")" href="/Users/Profile">
                    <span class="nav-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                        </svg>
                    </span>
                    <span class="nav-text">Settings</span>
                </a>
            </li>
            @if (IsAuthenticated)
            {
                <li class="nav-item user-info-item">
                    <div class="user-info-content">
                        <span class="user-avatar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                            </svg>
                        </span>
                        <span class="user-name">@UserName</span>
                    </div>
                </li>
                <li class="nav-item">
                    <form action="/Authentication/Logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link logout-btn">
                            <span class="nav-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                            </span>
                            <span class="nav-text">Sign out</span>
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" href="/Authentication/Login">
                        <span class="nav-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                <polyline points="10 17 15 12 10 7"/>
                                <line x1="15" y1="12" x2="3" y2="12"/>
                            </svg>
                        </span>
                        <span class="nav-text">Sign in</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>

<div class="sidebar-overlay d-lg-none" onclick="toggleSidebar()"></div>

@code {
    private ClaimsPrincipal? User => HttpContextAccessor.HttpContext?.User;
    private bool IsAuthenticated => User?.Identity?.IsAuthenticated ?? false;
    private bool IsSiteAdmin => User?.IsInRole(Roles.SiteAdmin) ?? false;
    private bool IsTeacher => User?.IsInRole(Roles.Teacher) ?? false;
    private bool IsStudent => User?.IsInRole(Roles.Student) ?? false;
    private string? UserName => User?.Identity?.Name;

    private bool IsActive(string controller) =>
        Navigation.Uri.Contains($"/{controller}", StringComparison.OrdinalIgnoreCase);

    private bool IsActiveUsers() =>
        Navigation.Uri.Contains("/Users", StringComparison.OrdinalIgnoreCase) &&
        !Navigation.Uri.Contains("/Users/Profile", StringComparison.OrdinalIgnoreCase);

    private bool IsActiveProfile() =>
        Navigation.Uri.Contains("/Users/Profile", StringComparison.OrdinalIgnoreCase);
}
