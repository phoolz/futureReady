@page "/Companies/Delete/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@inject ICompanyService CompanyService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Delete Company - Apiary</PageTitle>

<h1>Delete Company</h1>

<form id="delete-form" method="post" @formname="delete-company">
    <AntiforgeryToken />
    <input type="hidden" name="Id" value="@Id" />
</form>

@if (Company == null)
{
    <p>Loading...</p>
}
else
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this company?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Company Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Company.Name</dd>

                        <dt class="col-sm-4">Industry</dt>
                        <dd class="col-sm-8">@Company.Industry</dd>

                        <dt class="col-sm-4">City</dt>
                        <dd class="col-sm-8">@Company.City</dd>

                        <dt class="col-sm-4">State</dt>
                        <dd class="col-sm-8">@Company.State</dd>

                        <dt class="col-sm-4">Public Liability Insurance ($5M+)</dt>
                        <dd class="col-sm-8">
                            @if (Company.PublicLiabilityInsurance5M)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div>
                <button type="submit" form="delete-form" class="btn btn-danger">Delete</button>
                <a href="/Companies/Details/@Company.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private Company? Company { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;

        if (context != null && HttpMethods.IsPost(context.Request.Method))
        {
            await HandlePostAsync();
            return;
        }

        await LoadCompanyAsync();
    }

    private async Task LoadCompanyAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Company = await CompanyService.GetByIdAsync(Id, tenantId);

        if (Company == null)
        {
            var context = HttpContext ?? HttpContextAccessor.HttpContext;
            context?.Response.Redirect("/Companies");
        }
    }

    private async Task HandlePostAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;
        try
        {
            var tenantId = TenantProvider.GetCurrentTenantId();
            await CompanyService.DeleteAsync(Id, tenantId);
        }
        catch (Exception)
        {
            // Ignore errors during delete
        }

        context?.Response.Redirect("/Companies");
    }
}
