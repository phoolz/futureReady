@page "/Students"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@using Apiary.Models.Tables
@using Apiary.Components.Shared.Tables
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider

<PageTitle>Students - Apiary</PageTitle>

<div class="list-header">
    <div class="list-header-content">
        <h1>Students</h1>
        <p>Manage student records</p>
    </div>
    <div class="list-header-actions">
        <TableSearch Query="Query" Placeholder="Search students..." />
        <a href="/Students/Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add Student
        </a>
    </div>
</div>

<div class="list-table">
    <table>
        <thead>
            <tr>
                <SortableHeader Column="name" Title="Name" Query="Query" />
                <SortableHeader Column="year" Title="Year" Query="Query" />
                <SortableHeader Column="email" Title="Email" Query="Query" />
                <th>Phone</th>
                <th>Account</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Result != null)
        {
            @foreach (var item in Result.Items)
            {
                <tr class="clickable" onclick="window.location='/Students/Details/@item.Id'">
                    <td class="cell-primary">@item.FullName</td>
                    <td class="cell-secondary">@(item.YearLevel ?? "—")</td>
                    <td class="cell-secondary">@(item.Email ?? "—")</td>
                    <td class="cell-secondary">@(item.Phone ?? "—")</td>
                    <td>
                        <span class="indicator">
                            <span class="indicator-dot @(item.UserId.HasValue ? "yes" : "no")"></span>
                            @(item.UserId.HasValue ? "Linked" : "None")
                        </span>
                    </td>
                    <td>
                        <div class="row-actions">
                            <a href="/Students/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            <a href="/Students/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (Result != null && Result.TotalCount == 0)
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <p>No students found. Add your first student to get started.</p>
        </div>
    }
    <Pagination T="Student" Result="Result" Query="Query" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public int? Size { get; set; }

    private TableQuery Query { get; set; } = new();
    private PagedResult<Student>? Result { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Query = new TableQuery
        {
            Search = Search,
            Sort = Sort ?? "name",
            Dir = Dir ?? "asc",
            Page = Page ?? 1,
            Size = Size ?? 25
        };

        var tenantId = TenantProvider.GetCurrentTenantId();
        Result = await StudentService.GetPagedAsync(Query, tenantId);
    }
}
