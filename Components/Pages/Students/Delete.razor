@page "/Students/Delete/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Delete Student - Apiary</PageTitle>

<h1>Delete Student</h1>

<form id="delete-form" method="post" @formname="delete-student">
    <AntiforgeryToken />
    <input type="hidden" name="Id" value="@Id" />
</form>

@if (Student == null)
{
    <p>Loading...</p>
}
else
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this student?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Student Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Student.FullName</dd>

                        <dt class="col-sm-4">Student Number</dt>
                        <dd class="col-sm-8">@(Student.StudentNumber ?? "N/A")</dd>

                        <dt class="col-sm-4">Year Level</dt>
                        <dd class="col-sm-8">@(Student.YearLevel ?? "N/A")</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@(Student.Email ?? "N/A")</dd>

                        <dt class="col-sm-4">Account Status</dt>
                        <dd class="col-sm-8">
                            @if (Student.UserId.HasValue)
                            {
                                <span class="badge bg-success">Linked</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Account</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div>
                <button type="submit" form="delete-form" class="btn btn-danger">Delete</button>
                <a href="/Students/Details/@Student.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private Student? Student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;

        if (context != null && HttpMethods.IsPost(context.Request.Method))
        {
            await HandlePostAsync();
            return;
        }

        await LoadStudentAsync();
    }

    private async Task LoadStudentAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Student = await StudentService.GetByIdAsync(Id, tenantId);

        if (Student == null)
        {
            var context = HttpContext ?? HttpContextAccessor.HttpContext;
            context?.Response.Redirect("/Students");
        }
    }

    private async Task HandlePostAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;
        try
        {
            var tenantId = TenantProvider.GetCurrentTenantId();
            await StudentService.DeleteAsync(Id, tenantId);
        }
        catch (Exception)
        {
            // Ignore errors during delete
        }

        context?.Response.Redirect("/Students");
    }
}
