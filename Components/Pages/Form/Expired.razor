@page "/form/expired"

<PageTitle>Link Expired - Apiary</PageTitle>

<div class="form-section">
    <div class="form-section-header">
        <h2 class="form-section-title">Link Expired</h2>
    </div>
    <div class="form-section-content text-center py-5">
        <div class="text-warning mb-3" style="font-size: 4rem;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
        </div>
        <h4 class="mb-3">This link has expired</h4>
        <p class="text-muted mb-4">
            Form links are valid for 14 days. This link is no longer active.
        </p>
        <p class="text-muted">
            Please contact the school to request a new form link.
        </p>
    </div>
</div>
