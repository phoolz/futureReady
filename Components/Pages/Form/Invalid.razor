@page "/form/invalid"

<PageTitle>Form Unavailable - Apiary</PageTitle>

<div class="form-section">
    <div class="form-section-header">
        <h2 class="form-section-title">Form Unavailable</h2>
    </div>
    <div class="form-section-content text-center py-5">
        <div class="text-warning mb-3" style="font-size: 4rem;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h4 class="mb-3">This form link is no longer valid</h4>
        <p class="text-muted mb-4">
            The form you're trying to access may have expired, already been submitted, or the link is incorrect.
        </p>
        <p class="text-muted">
            Please contact the school if you believe this is an error or need a new form link.
        </p>
    </div>
</div>
