@page "/form/submitted"

<PageTitle>Form Submitted - Apiary</PageTitle>

<div class="form-section">
    <div class="form-section-header">
        <h2 class="form-section-title">Thank You!</h2>
    </div>
    <div class="form-section-content text-center py-5">
        <div class="text-success mb-3" style="font-size: 4rem;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="16 10 11 16 8 13"/>
            </svg>
        </div>
        <h4 class="mb-3">Your form has been submitted successfully</h4>
        <p class="text-muted mb-4">
            The school has been notified and will be in touch if any further information is needed.
        </p>
        <p class="text-muted">
            You may now close this window.
        </p>
    </div>
</div>
