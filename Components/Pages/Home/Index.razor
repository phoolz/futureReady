@page "/"
@layout MainLayout
@attribute [Authorize]
@attribute [StreamRendering]
@inject IStudentService StudentService
@inject IPlacementService PlacementService
@inject ILogbookEntryService LogbookService
@inject IStudentAuthorizationService StudentAuthService
@inject ITenantProvider TenantProvider

<PageTitle>Dashboard - Apiary</PageTitle>

<AuthorizeView Roles="@Roles.SiteAdmin">
    <Authorized>
        <div class="page-header">
            <h1 class="page-title">Admin Dashboard</h1>
            <p class="page-subtitle">Site Administration</p>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@Roles.Teacher">
    <Authorized>
        <div class="page-header">
            <h1 class="page-title">Teacher Dashboard</h1>
            <p class="page-subtitle">Welcome to Apiary</p>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@Roles.Student">
    <Authorized>
        @if (IsLoading)
        {
            <div class="page-header">
                <h1 class="page-title">Dashboard</h1>
                <p class="page-subtitle">Loading...</p>
            </div>
        }
        else if (StudentNotLinked)
        {
            <div class="page-header">
                <h1 class="page-title">Account Not Linked</h1>
            </div>

            <div class="details-container">
                <div class="alert alert-warning mb-4">
                    <h5 class="alert-heading">Your account is not linked to a student record</h5>
                    <p>Your user account has been created, but it hasn't been linked to a student profile in the system yet.</p>
                    <hr>
                    <p class="mb-0">Please contact your teacher or school administrator to have your account linked to your student record.</p>
                </div>

                <div class="text-center">
                    <form method="post" action="/Authentication/Logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary">
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (StudentModel != null)
        {
            <div class="page-header">
                <h1 class="page-title">Welcome, @StudentModel.StudentDisplayName</h1>
                <p class="page-subtitle">Your work placement dashboard</p>
            </div>

            @if (StudentModel.HasConfirmedPlacements)
            {
                <div class="placements-grid">
                    @foreach (var placement in StudentModel.ConfirmedPlacements)
                    {
                        <div class="placement-hero">
                            <div class="placement-hero-header">
                                <div class="placement-hero-company">
                                    <div class="company-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                                            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                                            <path d="M12 12v.01"/>
                                            <path d="M2 12h20"/>
                                        </svg>
                                    </div>
                                    <div class="company-info">
                                        <h2 class="company-name">@(placement.CompanyName ?? "Your Placement")</h2>
                                        @if (!string.IsNullOrEmpty(placement.CompanyIndustry))
                                        {
                                            <span class="company-industry">@placement.CompanyIndustry</span>
                                        }
                                    </div>
                                </div>
                                <span class="placement-status @(placement.StatusDisplayText?.ToLower() == "confirmed" ? "status-confirmed" : "")">
                                    <span class="status-dot"></span>
                                    @placement.StatusDisplayText
                                </span>
                            </div>

                            <div class="placement-hero-stats">
                                <div class="stat-hours">
                                    <div class="hours-ring">
                                        <span class="hours-value">@placement.TotalHoursWorked.ToString("0.#")</span>
                                        <span class="hours-label">hours</span>
                                    </div>
                                    <p class="hours-caption">Total time logged</p>
                                </div>

                                <div class="stat-details">
                                    @if (!string.IsNullOrEmpty(placement.WorkStartTime) || !string.IsNullOrEmpty(placement.WorkEndTime))
                                    {
                                        <div class="detail-item">
                                            <div class="detail-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <polyline points="12 6 12 12 16 14"/>
                                                </svg>
                                            </div>
                                            <div class="detail-content">
                                                <span class="detail-label">Work Hours</span>
                                                <span class="detail-value">@(placement.WorkStartTime ?? "—") – @(placement.WorkEndTime ?? "—")</span>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(placement.DressRequirement))
                                    {
                                        <div class="detail-item">
                                            <div class="detail-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
                                                </svg>
                                            </div>
                                            <div class="detail-content">
                                                <span class="detail-label">Dress Code</span>
                                                <span class="detail-value">@placement.DressRequirement</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(placement.SupervisorFullName))
                            {
                                <div class="placement-hero-supervisor">
                                    <div class="supervisor-avatar">
                                        @(placement.SupervisorFullName?.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="supervisor-info">
                                        <span class="supervisor-name">@placement.SupervisorFullName</span>
                                        @if (!string.IsNullOrEmpty(placement.SupervisorJobTitle))
                                        {
                                            <span class="supervisor-title">@placement.SupervisorJobTitle</span>
                                        }
                                    </div>
                                    <div class="supervisor-contact">
                                        @if (!string.IsNullOrEmpty(placement.SupervisorPhone))
                                        {
                                            <a href="tel:@placement.SupervisorPhone" class="contact-btn" title="Call">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                                </svg>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(placement.SupervisorEmail))
                                        {
                                            <a href="mailto:@placement.SupervisorEmail" class="contact-btn" title="Email">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                </svg>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="placement-hero-actions">
                                <a href="/student/logbook/@placement.PlacementId" class="action-primary">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 5v14M5 12h14"/>
                                    </svg>
                                    Log Today's Hours
                                </a>
                                <a href="/LogbookEntries/@placement.PlacementId" class="action-secondary">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="16" x2="8" y1="13" y2="13"/>
                                        <line x1="16" x2="8" y1="17" y2="17"/>
                                        <line x1="10" x2="8" y1="9" y2="9"/>
                                    </svg>
                                    View Logbook
                                </a>
                                <a href="/Placements/Details/@placement.PlacementId" class="action-secondary">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4"/>
                                        <path d="M12 8h.01"/>
                                    </svg>
                                    Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-card">
                    <div class="empty-state-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                            <rect x="8" y="2" width="8" height="4" rx="1"/>
                            <path d="M12 11v6"/>
                            <path d="M9 14h6"/>
                        </svg>
                    </div>
                    <h3>No Active Placements</h3>
                    <p>Once your placement is confirmed by your parent/guardian and employer, it will appear here.</p>
                </div>
            }

            @if (StudentModel.HasPendingPlacements)
            {
                <h5 class="mb-3">Pending Placements</h5>
                <div class="details-container mb-4">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Company</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var placement in StudentModel.PendingPlacements)
                                {
                                    <tr>
                                        <td>@(placement.Year?.ToString() ?? "N/A")</td>
                                        <td>@(placement.CompanyName ?? "Not assigned")</td>
                                        <td><span class="badge @placement.StatusDisplayClass">@placement.StatusDisplayText</span></td>
                                        <td>
                                            <a href="/Placements/Details/@placement.PlacementId" class="btn btn-sm btn-outline-primary">
                                                View Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="page-header">
                <h1 class="page-title">Student Dashboard</h1>
                <p class="page-subtitle">Your work placement dashboard</p>
            </div>

            <div class="alert alert-warning">
                <p class="mb-0">Unable to load your dashboard. Please try refreshing the page or contact your administrator.</p>
            </div>
        }
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h5>No Role Assigned</h5>
            <p>Please contact your administrator.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private StudentPortalViewModel? StudentModel { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool StudentNotLinked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var user = authState.User;

        if (!user.IsInRole(Roles.Student))
        {
            IsLoading = false;
            return;
        }

        var tenantId = TenantProvider.GetCurrentTenantId();
        var studentId = await StudentAuthService.GetCurrentUserStudentIdAsync();

        if (!studentId.HasValue)
        {
            StudentNotLinked = true;
            IsLoading = false;
            return;
        }

        var student = await StudentService.GetByIdAsync(studentId.Value, tenantId);
        if (student == null)
        {
            StudentNotLinked = true;
            IsLoading = false;
            return;
        }

        var placements = await PlacementService.GetByStudentIdAsync(studentId.Value, tenantId);
        var placementViewModels = new List<StudentPlacementViewModel>();

        foreach (var placement in placements)
        {
            // Get the PlacementStudent record for the current student to calculate hours correctly
            var placementStudent = placement.PlacementStudents
                .FirstOrDefault(ps => ps.StudentId == studentId.Value && !ps.IsDeleted);

            decimal totalHours = 0;
            if (placementStudent != null)
            {
                totalHours = await LogbookService.GetTotalHoursAsync(placementStudent.Id, tenantId);
            }

            placementViewModels.Add(new StudentPlacementViewModel
            {
                PlacementId = placement.Id,
                Year = placement.Year,
                Status = placement.Status,
                CompanyName = placement.Company?.Name,
                CompanyIndustry = placement.Company?.Industry,
                SupervisorFullName = placement.Supervisor?.FullName,
                SupervisorJobTitle = placement.Supervisor?.JobTitle,
                SupervisorEmail = placement.Supervisor?.Email,
                SupervisorPhone = placement.Supervisor?.Phone,
                WorkStartTime = placement.WorkStartTime,
                WorkEndTime = placement.WorkEndTime,
                DressRequirement = placement.DressRequirement,
                TotalHoursWorked = totalHours
            });
        }

        StudentModel = new StudentPortalViewModel
        {
            StudentId = student.Id,
            StudentDisplayName = student.DisplayName,
            StudentFullName = student.FullName,
            ConfirmedPlacements = placementViewModels.Where(p => p.IsConfirmed).ToList(),
            PendingPlacements = placementViewModels.Where(p => !p.IsConfirmed).ToList()
        };

        IsLoading = false;
    }
}
