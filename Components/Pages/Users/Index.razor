@page "/Users"
@attribute [Authorize(Roles = Roles.SiteAdmin)]
@attribute [StreamRendering]
@using Apiary.Models.Tables
@using Apiary.Components.Shared.Tables
@inject IUserService UserService

<PageTitle>Users - Apiary</PageTitle>

<div class="list-header">
    <div class="list-header-content">
        <h1>Users</h1>
        <p>Manage user accounts</p>
    </div>
    <div class="list-header-actions">
        <TableSearch Query="Query" Placeholder="Search users..." />
        <a href="/Users/Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add User
        </a>
    </div>
</div>

<div class="list-table">
    <table>
        <thead>
            <tr>
                <SortableHeader Column="name" Title="Display Name" Query="Query" />
                <th>Username</th>
                <SortableHeader Column="email" Title="Email" Query="Query" />
                <SortableHeader Column="role" Title="Role" Query="Query" />
                <th>School</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Result != null)
        {
            @foreach (var item in Result.Items)
            {
                <tr class="clickable" onclick="window.location='/Users/Details/@item.Id'">
                    <td class="cell-primary">@(item.DisplayName ?? item.UserName)</td>
                    <td class="cell-secondary">@item.UserName</td>
                    <td class="cell-secondary">@(item.Email ?? "—")</td>
                    <td class="cell-secondary">@item.RoleName</td>
                    <td class="cell-secondary">@(item.TenantName ?? "—")</td>
                    <td>
                        <span class="indicator">
                            <span class="indicator-dot @(item.IsActive ? "yes" : "no")"></span>
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <div class="row-actions">
                            <a href="/Users/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            <a href="/Users/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                </svg>
                            </a>
                            <a href="/Users/Delete/@item.Id" class="row-action action-delete" title="Delete" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (Result != null && Result.TotalCount == 0)
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <p>No users found. Add your first user to get started.</p>
        </div>
    }
    <Pagination T="UserViewModel" Result="Result" Query="Query" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public int? Size { get; set; }

    private TableQuery Query { get; set; } = new();
    private PagedResult<UserViewModel>? Result { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Query = new TableQuery
        {
            Search = Search,
            Sort = Sort ?? "name",
            Dir = Dir ?? "asc",
            Page = Page ?? 1,
            Size = Size ?? 25
        };

        Result = await UserService.GetPagedAsync(Query);
    }
}
