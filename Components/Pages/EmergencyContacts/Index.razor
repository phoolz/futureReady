@page "/EmergencyContacts/{StudentId:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@inject IEmergencyContactService EmergencyContactService
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Emergency Contacts - Apiary</PageTitle>

@if (Student == null)
{
    <p>Loading...</p>
}
else
{
    <div class="list-header">
        <div class="list-header-content">
            <h1>Emergency Contacts</h1>
            <p>For @Student.FullName</p>
        </div>
        <div class="list-header-actions">
            <a href="/EmergencyContacts/Create?studentId=@StudentId" class="btn-add">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Add Contact
            </a>
        </div>
    </div>

    <div class="mb-3">
        <a href="/Students/Details/@StudentId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Student
        </a>
    </div>

    <div class="list-table">
        <table id="dataTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Relationship</th>
                    <th>Mobile</th>
                    <th>Primary</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Contacts != null)
            {
                @foreach (var item in Contacts)
                {
                    <tr class="clickable" onclick="window.location='/EmergencyContacts/Details/@item.Id'">
                        <td class="cell-primary">@item.FullName</td>
                        <td class="cell-secondary">@(item.Relationship ?? "—")</td>
                        <td class="cell-secondary">@(item.MobileNumber ?? "—")</td>
                        <td>
                            <span class="indicator">
                                <span class="indicator-dot @(item.IsPrimary ? "yes" : "no")"></span>
                                @(item.IsPrimary ? "Yes" : "No")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a href="/EmergencyContacts/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </a>
                                <a href="/EmergencyContacts/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        @if (Contacts != null && !Contacts.Any())
        {
            <div class="list-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <p>No emergency contacts found. Add the first emergency contact for this student.</p>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid StudentId { get; set; }

    private Student? Student { get; set; }
    private List<EmergencyContact>? Contacts { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Student = await StudentService.GetByIdAsync(StudentId, tenantId);

        if (Student == null)
        {
            HttpContextAccessor.HttpContext?.Response.Redirect("/Students");
            return;
        }

        Contacts = await EmergencyContactService.GetAllByStudentIdAsync(StudentId, tenantId);
    }
}
