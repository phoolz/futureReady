@page "/EmergencyContacts/Details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@inject IEmergencyContactService EmergencyContactService
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Emergency Contact Details - Apiary</PageTitle>

@if (Contact == null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Emergency Contact</h1>
            <p class="text-muted mb-0">@Contact.FullName</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/EmergencyContacts/Edit/@Contact.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/EmergencyContacts/Delete/@Contact.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i> Delete
            </a>
        </div>
    </div>

    <div class="mb-3">
        <a href="/EmergencyContacts/@Contact.StudentId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Emergency Contacts
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Contact Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Contact.FirstName</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@Contact.LastName</dd>

                        <dt class="col-sm-4">Mobile Number</dt>
                        <dd class="col-sm-8">@(Contact.MobileNumber ?? "N/A")</dd>

                        <dt class="col-sm-4">Relationship</dt>
                        <dd class="col-sm-8">@(Contact.Relationship ?? "N/A")</dd>

                        <dt class="col-sm-4">Primary Contact</dt>
                        <dd class="col-sm-8">
                            @if (Contact.IsPrimary)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Student != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Student</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">
                                <a href="/Students/Details/@Student.Id">@Student.FullName</a>
                            </dd>

                            <dt class="col-sm-4">Year Level</dt>
                            <dd class="col-sm-8">@(Student.YearLevel ?? "N/A")</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private EmergencyContact? Contact { get; set; }
    private Student? Student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Contact = await EmergencyContactService.GetByIdAsync(Id, tenantId);

        if (Contact == null)
        {
            HttpContextAccessor.HttpContext?.Response.Redirect("/Students");
            return;
        }

        Student = await StudentService.GetByIdAsync(Contact.StudentId, tenantId);
    }
}
