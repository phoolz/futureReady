@page "/Schools/Delete/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.SiteAdmin)]
@inject ISchoolService SchoolService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Delete School - Apiary</PageTitle>

<h1>Delete School</h1>

<form id="delete-form" method="post" @formname="delete-school">
    <AntiforgeryToken />
    <input type="hidden" name="Id" value="@Id" />
</form>

@if (School == null)
{
    <p>Loading...</p>
}
else
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this school?</h4>
        <p>This action cannot be undone. All data associated with this school will be permanently deleted.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">School Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@School.Name</dd>

                        <dt class="col-sm-4">Tenant Key</dt>
                        <dd class="col-sm-8">@School.TenantKey</dd>

                        <dt class="col-sm-4">Timezone</dt>
                        <dd class="col-sm-8">@School.Timezone</dd>

                        <dt class="col-sm-4">Contact Email</dt>
                        <dd class="col-sm-8">@(School.ContactEmail ?? "—")</dd>

                        <dt class="col-sm-4">Contact Phone</dt>
                        <dd class="col-sm-8">@(School.ContactPhone ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <div>
                <button type="submit" form="delete-form" class="btn btn-danger">Delete</button>
                <a href="/Schools/Details/@School.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private School? School { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;

        if (context != null && HttpMethods.IsPost(context.Request.Method))
        {
            await HandlePostAsync();
            return;
        }

        await LoadSchoolAsync();
    }

    private async Task LoadSchoolAsync()
    {
        School = await SchoolService.GetByIdAsync(Id);

        if (School == null)
        {
            var context = HttpContext ?? HttpContextAccessor.HttpContext;
            context?.Response.Redirect("/Schools");
        }
    }

    private async Task HandlePostAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;
        try
        {
            await SchoolService.DeleteAsync(Id);
        }
        catch (Exception)
        {
            // Ignore errors during delete
        }

        context?.Response.Redirect("/Schools");
    }
}
