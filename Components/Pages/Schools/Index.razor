@page "/Schools"
@layout MainLayout
@attribute [Authorize(Roles = Roles.SiteAdmin)]
@attribute [StreamRendering]
@using Apiary.Models.Tables
@using Apiary.Components.Shared.Tables
@inject ISchoolService SchoolService

<PageTitle>Schools - Apiary</PageTitle>

<div class="list-header">
    <div class="list-header-content">
        <h1>Schools</h1>
        <p>Manage tenant schools</p>
    </div>
    <div class="list-header-actions">
        <TableSearch Query="Query" Placeholder="Search schools..." />
        <a href="/Schools/Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add School
        </a>
    </div>
</div>

<div class="list-table">
    <table>
        <thead>
            <tr>
                <SortableHeader Column="name" Title="Name" Query="Query" />
                <SortableHeader Column="tenantkey" Title="Tenant Key" Query="Query" />
                <th>Timezone</th>
                <th>Contact Email</th>
                <th>Contact Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Result != null)
        {
            @foreach (var item in Result.Items)
            {
                <tr class="clickable" onclick="window.location='/Schools/Details/@item.Id'">
                    <td class="cell-primary">@item.Name</td>
                    <td class="cell-secondary">@item.TenantKey</td>
                    <td class="cell-secondary">@item.Timezone</td>
                    <td class="cell-secondary">@(item.ContactEmail ?? "—")</td>
                    <td class="cell-secondary">@(item.ContactPhone ?? "—")</td>
                    <td>
                        <div class="row-actions">
                            <a href="/Schools/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            <a href="/Schools/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                </svg>
                            </a>
                            <a href="/Schools/Delete/@item.Id" class="row-action action-delete" title="Delete" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (Result != null && Result.TotalCount == 0)
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <p>No schools found. Add your first school to get started.</p>
        </div>
    }
    <Pagination T="School" Result="Result" Query="Query" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public int? Size { get; set; }

    private TableQuery Query { get; set; } = new();
    private PagedResult<School>? Result { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Query = new TableQuery
        {
            Search = Search,
            Sort = Sort ?? "name",
            Dir = Dir ?? "asc",
            Page = Page ?? 1,
            Size = Size ?? 25
        };

        Result = await SchoolService.GetPagedAsync(Query);
    }
}
