@page "/StudentMedicalConditions/Details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@inject IStudentMedicalConditionService MedicalConditionService
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Medical Condition Details - Apiary</PageTitle>

@if (Condition == null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Medical Condition</h1>
            <p class="text-muted mb-0">@MedicalConditionTypes.GetDisplayName(Condition.ConditionType)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/StudentMedicalConditions/Edit/@Condition.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/StudentMedicalConditions/Delete/@Condition.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i> Delete
            </a>
        </div>
    </div>

    <div class="mb-3">
        <a href="/StudentMedicalConditions/@Condition.StudentId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Medical Conditions
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Condition Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Condition Type</dt>
                        <dd class="col-sm-9">@MedicalConditionTypes.GetDisplayName(Condition.ConditionType)</dd>

                        <dt class="col-sm-3">Details</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrEmpty(Condition.Details))
                            {
                                <span class="text-muted">No details provided.</span>
                            }
                            else
                            {
                                <div style="white-space: pre-wrap;">@Condition.Details</div>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Student != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Student</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Name</dt>
                            <dd class="col-sm-9">
                                <a href="/Students/Details/@Student.Id">@Student.FullName</a>
                            </dd>

                            <dt class="col-sm-3">Year Level</dt>
                            <dd class="col-sm-9">@(Student.YearLevel ?? "N/A")</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private StudentMedicalCondition? Condition { get; set; }
    private Student? Student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Condition = await MedicalConditionService.GetByIdAsync(Id, tenantId);

        if (Condition == null)
        {
            HttpContextAccessor.HttpContext?.Response.Redirect("/Students");
            return;
        }

        Student = await StudentService.GetByIdAsync(Condition.StudentId, tenantId);
    }
}
