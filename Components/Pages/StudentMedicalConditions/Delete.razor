@page "/StudentMedicalConditions/Delete/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@inject IStudentMedicalConditionService MedicalConditionService
@inject IStudentService StudentService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Delete Medical Condition - Apiary</PageTitle>

<h1>Delete Medical Condition</h1>

<form id="delete-form" method="post" @formname="delete-medical-condition">
    <AntiforgeryToken />
    <input type="hidden" name="Id" value="@Id" />
</form>

@if (Condition == null)
{
    <p>Loading...</p>
}
else
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this medical condition?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Condition Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Condition Type</dt>
                        <dd class="col-sm-9">@MedicalConditionTypes.GetDisplayName(Condition.ConditionType)</dd>

                        <dt class="col-sm-3">Details</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrEmpty(Condition.Details))
                            {
                                <span class="text-muted">No details provided.</span>
                            }
                            else
                            {
                                @(Condition.Details.Length > 200 ? Condition.Details.Substring(0, 200) + "..." : Condition.Details)
                            }
                        </dd>

                        @if (Student != null)
                        {
                            <dt class="col-sm-3">Student</dt>
                            <dd class="col-sm-9">@Student.FullName</dd>
                        }
                    </dl>
                </div>
            </div>

            <div>
                <button type="submit" form="delete-form" class="btn btn-danger">Delete</button>
                <a href="/StudentMedicalConditions/@Condition.StudentId" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private StudentMedicalCondition? Condition { get; set; }
    private Student? Student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;

        if (context != null && HttpMethods.IsPost(context.Request.Method))
        {
            await HandlePostAsync();
            return;
        }

        await LoadConditionAsync();
    }

    private async Task LoadConditionAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Condition = await MedicalConditionService.GetByIdAsync(Id, tenantId);

        if (Condition == null)
        {
            var context = HttpContext ?? HttpContextAccessor.HttpContext;
            context?.Response.Redirect("/Students");
        }
        else
        {
            Student = await StudentService.GetByIdAsync(Condition.StudentId, tenantId);
        }
    }

    private async Task HandlePostAsync()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;
        var tenantId = TenantProvider.GetCurrentTenantId();

        var condition = await MedicalConditionService.GetByIdAsync(Id, tenantId);
        var studentId = condition?.StudentId;

        try
        {
            await MedicalConditionService.DeleteAsync(Id, tenantId);
        }
        catch (Exception)
        {
            // Ignore errors during delete
        }

        if (studentId.HasValue)
        {
            context?.Response.Redirect($"/StudentMedicalConditions/{studentId}");
        }
        else
        {
            context?.Response.Redirect("/Students");
        }
    }
}
