@page "/Placements"
@attribute [Authorize(Roles = Roles.TeacherOrStudent)]
@attribute [StreamRendering]
@using Apiary.Models.Tables
@using Apiary.Components.Shared.Tables
@inject IPlacementService PlacementService
@inject IStudentAuthorizationService StudentAuthService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Placements - Apiary</PageTitle>

<div class="list-header">
    <div class="list-header-content">
        <h1>Placements</h1>
        <p>Manage student work experience placements</p>
    </div>
    <div class="list-header-actions">
        <TableSearch Query="Query" Placeholder="Search placements..." />
        @if (IsTeacher)
        {
            <a href="/Placements/Create" class="btn-add">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Add Placement
            </a>
        }
    </div>
</div>

<div class="list-table">
    <table>
        <thead>
            <tr>
                <SortableHeader Column="role" Title="Role" Query="Query" />
                <SortableHeader Column="company" Title="Company" Query="Query" />
                <th>Supervisor</th>
                <SortableHeader Column="year" Title="Year" Query="Query" />
                <th>Dates</th>
                <SortableHeader Column="status" Title="Status" Query="Query" />
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Result != null)
        {
            @foreach (var item in Result.Items)
            {
                var statusClass = item.Status switch
                {
                    "confirmed" => "status-success",
                    "pending_employer" => "status-warning",
                    "pending_parent" => "status-info",
                    "pending_parents" => "status-info",
                    "partial" => "status-info",
                    _ => "status-neutral"
                };
                var statusText = item.Status switch
                {
                    "confirmed" => "Confirmed",
                    "pending_employer" => "Pending Employer",
                    "pending_parent" => "Pending Parent",
                    "pending_parents" => "Pending Parents",
                    "partial" => "Partial",
                    _ => item.Status ?? "Draft"
                };

                var placementStudents = item.PlacementStudents?.Where(ps => !ps.IsDeleted).ToList() ?? new List<PlacementStudent>();
                var studentCount = placementStudents.Count;

                <tr class="clickable" onclick="window.location='/Placements/Details/@item.Id'">
                    <td class="cell-primary">
                        @if (!string.IsNullOrEmpty(item.PlacementRole))
                        {
                            <span>@item.PlacementRole</span>
                        }
                        else
                        {
                            <span class="cell-secondary">No role specified</span>
                        }
                        @if (studentCount > 0)
                        {
                            <span class="badge bg-secondary ms-1">@studentCount</span>
                        }
                    </td>
                    <td>@(item.Company?.Name ?? "—")</td>
                    <td class="cell-secondary">
                        @if (item.Supervisor != null)
                        {
                            @($"{item.Supervisor.FirstName} {item.Supervisor.LastName}")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="cell-secondary">@(item.Year?.ToString() ?? "—")</td>
                    <td class="cell-secondary">
                        @if (item.StartDate.HasValue || item.FinishDate.HasValue)
                        {
                            @(item.StartDate?.ToString("d MMM") ?? "?")@(" – ")@(item.FinishDate?.ToString("d MMM") ?? "?")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>
                        <span class="status-badge @statusClass">@statusText</span>
                    </td>
                    <td>
                        <div class="row-actions">
                            <a href="/Placements/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            @if (IsTeacher)
                            {
                                <a href="/Placements/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                    </svg>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (Result != null && Result.TotalCount == 0)
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <rect x="8" y="2" width="8" height="4" rx="1"/>
            </svg>
            <p>No placements found. Create your first placement to get started.</p>
        </div>
    }
    <Pagination T="Placement" Result="Result" Query="Query" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public int? Size { get; set; }

    private TableQuery Query { get; set; } = new();
    private PagedResult<Placement>? Result { get; set; }
    private bool IsTeacher { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Query = new TableQuery
        {
            Search = Search,
            Sort = Sort ?? "role",
            Dir = Dir ?? "asc",
            Page = Page ?? 1,
            Size = Size ?? 25
        };

        var context = HttpContextAccessor.HttpContext;
        IsTeacher = context?.User?.IsInRole(Roles.Teacher) ?? false;

        var tenantId = TenantProvider.GetCurrentTenantId();

        if (context?.User?.IsInRole(Roles.Student) == true)
        {
            var studentId = await StudentAuthService.GetCurrentUserStudentIdAsync();
            if (studentId.HasValue)
            {
                // For students, use non-paged results scoped to their placements
                var placements = await PlacementService.GetByStudentIdAsync(studentId.Value, tenantId);
                Result = new PagedResult<Placement>
                {
                    Items = placements,
                    TotalCount = placements.Count,
                    Page = 1,
                    Size = placements.Count
                };
            }
            else
            {
                Result = PagedResult<Placement>.Empty();
            }
        }
        else
        {
            Result = await PlacementService.GetPagedAsync(Query, tenantId);
        }
    }
}
