@page "/Supervisors"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@using Apiary.Models.Tables
@using Apiary.Components.Shared.Tables
@inject ISupervisorService SupervisorService
@inject ITenantProvider TenantProvider

<PageTitle>Supervisors - Apiary</PageTitle>

<div class="list-header">
    <div class="list-header-content">
        <h1>Supervisors</h1>
        <p>Manage workplace supervisors</p>
    </div>
    <div class="list-header-actions">
        <TableSearch Query="Query" Placeholder="Search supervisors..." />
        <a href="/Supervisors/Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add Supervisor
        </a>
    </div>
</div>

<div class="list-table">
    <table>
        <thead>
            <tr>
                <SortableHeader Column="name" Title="Name" Query="Query" />
                <SortableHeader Column="company" Title="Company" Query="Query" />
                <th>Job Title</th>
                <SortableHeader Column="email" Title="Email" Query="Query" />
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Result != null)
        {
            @foreach (var item in Result.Items)
            {
                <tr class="clickable" onclick="window.location='/Supervisors/Details/@item.Id'">
                    <td class="cell-primary">@item.FullName</td>
                    <td>@(item.Company?.Name ?? "—")</td>
                    <td class="cell-secondary">@(item.JobTitle ?? "—")</td>
                    <td class="cell-secondary">
                        @if (!string.IsNullOrEmpty(item.Email))
                        {
                            <a href="mailto:@item.Email" onclick="event.stopPropagation()">@item.Email</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="cell-secondary">@(item.Phone ?? "—")</td>
                    <td>
                        <div class="row-actions">
                            <a href="/Supervisors/Details/@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            <a href="/Supervisors/Edit/@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                </svg>
                            </a>
                            <a href="/Supervisors/Delete/@item.Id" class="row-action action-delete" title="Delete" onclick="event.stopPropagation()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (Result != null && Result.TotalCount == 0)
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
            </svg>
            <p>No supervisors found. Add your first supervisor to get started.</p>
        </div>
    }
    <Pagination T="Supervisor" Result="Result" Query="Query" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public int? Size { get; set; }

    private TableQuery Query { get; set; } = new();
    private PagedResult<Supervisor>? Result { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Query = new TableQuery
        {
            Search = Search,
            Sort = Sort ?? "name",
            Dir = Dir ?? "asc",
            Page = Page ?? 1,
            Size = Size ?? 25
        };

        var tenantId = TenantProvider.GetCurrentTenantId();
        Result = await SupervisorService.GetPagedAsync(Query, tenantId);
    }
}
