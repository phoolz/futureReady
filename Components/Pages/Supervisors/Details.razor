@page "/Supervisors/Details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = Roles.Teacher)]
@attribute [StreamRendering]
@inject ISupervisorService SupervisorService
@inject ITenantProvider TenantProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Supervisor Details - Apiary</PageTitle>

@if (Supervisor == null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Supervisor.FullName</h1>
        <div>
            <a href="/Supervisors/Edit/@Supervisor.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/Supervisors" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Supervisor Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Company</dt>
                        <dd class="col-sm-8">
                            @if (Supervisor.Company != null)
                            {
                                <a href="/Companies/Details/@Supervisor.CompanyId">@Supervisor.Company.Name</a>
                            }
                        </dd>

                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Supervisor.FirstName</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@Supervisor.LastName</dd>

                        <dt class="col-sm-4">Job Title</dt>
                        <dd class="col-sm-8">@Supervisor.JobTitle</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Supervisor.Email))
                            {
                                <a href="mailto:@Supervisor.Email">@Supervisor.Email</a>
                            }
                        </dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Supervisor.Phone</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Supervisor? Supervisor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantProvider.GetCurrentTenantId();
        Supervisor = await SupervisorService.GetByIdAsync(Id, tenantId);

        if (Supervisor == null)
        {
            HttpContextAccessor.HttpContext?.Response.Redirect("/Supervisors");
        }
    }
}
