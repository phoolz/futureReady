@page "/employer/form/{Token}"
@layout EmployerFormLayout
@attribute [StreamRendering]
@inject NavigationManager Navigation

<PageTitle>Employer Acceptance Form</PageTitle>

@* Redirect to step 1 *@

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/employer/form/{Token}/step1", replace: true);
    }
}
