@page "/employer/form/{Token}"
@layout EmployerFormLayout
@attribute [StreamRendering]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Employer Acceptance Form</PageTitle>

@* Redirect to step 1 *@

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        HttpContextAccessor.HttpContext?.Response.Redirect($"/employer/form/{Token}/step1");
    }
}
