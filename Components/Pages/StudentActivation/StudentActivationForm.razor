@page "/student/activate/{Token}"
@layout StudentActivationLayout
@attribute [StreamRendering]
@inject IStudentActivationService ActivationService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Apiary.Components.Pages.EmployerForm.Shared

<PageTitle>Activate Your Account</PageTitle>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <FormSection Title="Unable to Activate Account">
        <div class="text-center py-4">
            <div class="text-danger mb-3" style="font-size: 4rem;">&#10007;</div>
            <h4>@ErrorMessage</h4>
            <p class="text-muted">
                Please contact your school if you believe this is an error.
            </p>
        </div>
    </FormSection>
}
else if (IsSuccess)
{
    <FormSection Title="Account Created Successfully">
        <div class="text-center py-4">
            <div class="text-success mb-3" style="font-size: 4rem;">&#10003;</div>
            <h4>Welcome, @FormData?.FirstName!</h4>
            <p class="text-muted">
                Your account has been created successfully. You can now log in with your email and password.
            </p>
            <a href="/Authentication/Login" class="btn btn-primary mt-3">
                Go to Login
            </a>
        </div>
    </FormSection>
}
else if (FormData != null)
{
    <form method="post" @formname="student-activation" @onsubmit="HandleSubmit">
        <AntiforgeryToken />

        <FormSection Title="Account Details">
            <p class="text-muted mb-3">Please confirm your details below.</p>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" value="@FormData.FirstName" readonly />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" value="@FormData.LastName" readonly />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" value="@FormData.Email" readonly />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Set Your Password">
            <p class="text-muted mb-3">Create a secure password for your account.</p>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" name="FormModel.Password" value="@FormModel?.Password" />
                    <small class="form-text text-muted">
                        Must be at least 8 characters with uppercase, lowercase, and a number.
                    </small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" name="FormModel.ConfirmPassword" value="@FormModel?.ConfirmPassword" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Personal Information">
            <p class="text-muted mb-3">Update your personal information (optional).</p>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Preferred Name</label>
                    <input type="text" class="form-control" name="FormModel.PreferredName" value="@FormModel?.PreferredName" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" class="form-control" name="FormModel.DateOfBirth" value="@FormModel?.DateOfBirth?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="tel" class="form-control" name="FormModel.Phone" value="@FormModel?.Phone" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Medicare Number</label>
                    <input type="text" class="form-control" name="FormModel.MedicareNumber" value="@FormModel?.MedicareNumber" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Academic Information">
            <p class="text-muted mb-3">Update your academic information (optional).</p>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Student Number</label>
                    <input type="text" class="form-control" name="FormModel.StudentNumber" value="@FormModel?.StudentNumber" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Student Type</label>
                    <select class="form-select" name="FormModel.StudentType">
                        <option value="">Select Type</option>
                        <option value="day" selected="@(FormModel?.StudentType == "day")">Day</option>
                        <option value="boarding" selected="@(FormModel?.StudentType == "boarding")">Boarding</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Year Level</label>
                    <input type="text" class="form-control" name="FormModel.YearLevel" value="@FormModel?.YearLevel" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Graduation Year</label>
                    <input type="number" class="form-control" name="FormModel.GraduationYear" value="@FormModel?.GraduationYear" />
                </div>
            </div>
        </FormSection>

        @if (!string.IsNullOrEmpty(SubmitError))
        {
            <div class="alert alert-danger mt-3">
                @SubmitError
            </div>
        }

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
                Create Account
            </button>
        </div>
    </form>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "student-activation")]
    private StudentActivationFormModel? FormModel { get; set; }

    private StudentActivationDto? FormData { get; set; }
    private bool IsSuccess { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SubmitError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            FormData = await ActivationService.InitializeFormAsync(Token);

            if (FormData == null)
            {
                ErrorMessage = "This activation link is invalid, has expired, or has already been used.";
                return;
            }

            // Initialize FormModel with values from FormData
            FormModel ??= new StudentActivationFormModel
            {
                PreferredName = FormData.PreferredName,
                DateOfBirth = FormData.DateOfBirth,
                Phone = FormData.Phone,
                StudentNumber = FormData.StudentNumber,
                StudentType = FormData.StudentType,
                YearLevel = FormData.YearLevel,
                GraduationYear = FormData.GraduationYear,
                MedicareNumber = FormData.MedicareNumber
            };
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while loading the form. Please try again later.";
            Console.WriteLine($"Initialization error: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        if (FormData == null || FormModel == null) return;

        SubmitError = null;

        try
        {
            // Validate password
            if (string.IsNullOrWhiteSpace(FormModel.Password))
            {
                SubmitError = "Password is required.";
                return;
            }

            if (FormModel.Password.Length < 8)
            {
                SubmitError = "Password must be at least 8 characters.";
                return;
            }

            if (FormModel.Password != FormModel.ConfirmPassword)
            {
                SubmitError = "Passwords do not match.";
                return;
            }

            // Apply form values to FormData
            FormData.Password = FormModel.Password;
            FormData.ConfirmPassword = FormModel.ConfirmPassword;
            FormData.PreferredName = FormModel.PreferredName;
            FormData.DateOfBirth = FormModel.DateOfBirth;
            FormData.Phone = FormModel.Phone;
            FormData.StudentNumber = FormModel.StudentNumber;
            FormData.StudentType = FormModel.StudentType;
            FormData.YearLevel = FormModel.YearLevel;
            FormData.GraduationYear = FormModel.GraduationYear;
            FormData.MedicareNumber = FormModel.MedicareNumber;

            var (success, errorMessage) = await ActivationService.ActivateAccountAsync(Token, FormData);

            if (success)
            {
                IsSuccess = true;
            }
            else
            {
                SubmitError = errorMessage ?? "Failed to create account. Please try again.";
            }
        }
        catch (Exception ex)
        {
            SubmitError = "An error occurred while creating your account. Please try again.";
            Console.WriteLine($"Submit error: {ex.Message}");
        }
    }

    private class StudentActivationFormModel
    {
        public string? Password { get; set; }
        public string? ConfirmPassword { get; set; }
        public string? PreferredName { get; set; }
        public DateOnly? DateOfBirth { get; set; }
        public string? Phone { get; set; }
        public string? StudentNumber { get; set; }
        public string? StudentType { get; set; }
        public string? YearLevel { get; set; }
        public int? GraduationYear { get; set; }
        public string? MedicareNumber { get; set; }
    }
}
