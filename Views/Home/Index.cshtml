@using FutureReady.Models
@{
    ViewData["Title"] = "Dashboard";
    var isSiteAdmin = User.IsInRole(Roles.SiteAdmin);
    var isTeacher = User.IsInRole(Roles.Teacher);
    var isStudent = User.IsInRole(Roles.Student);
}

@if (isSiteAdmin)
{
    @await Html.PartialAsync("_AdminDashboard")
}
else if (isTeacher)
{
    @await Html.PartialAsync("_TeacherDashboard")
}
else if (isStudent)
{
    @await Html.PartialAsync("_StudentDashboard")
}
else
{
    <div class="alert alert-warning">
        <h5>No Role Assigned</h5>
        <p>Please contact your administrator.</p>
    </div>
}
