@using Apiary.Models.StudentPortal
@{
    var viewModel = ViewData["StudentPortalModel"] as StudentPortalViewModel;
    var studentNotLinked = ViewData["StudentNotLinked"] as bool? ?? false;
}

@if (studentNotLinked)
{
    <div class="page-header">
        <h1 class="page-title">Account Not Linked</h1>
    </div>

    <div class="details-container">
        <div class="alert alert-warning mb-4">
            <h5 class="alert-heading">Your account is not linked to a student record</h5>
            <p>Your user account has been created, but it hasn't been linked to a student profile in the system yet.</p>
            <hr>
            <p class="mb-0">Please contact your teacher or school administrator to have your account linked to your student record.</p>
        </div>

        <div class="text-center">
            <form asp-controller="Authentication" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">
                    Logout
                </button>
            </form>
        </div>
    </div>
}
else if (viewModel != null)
{
    <div class="page-header">
        <h1 class="page-title">Welcome, @viewModel.StudentDisplayName</h1>
        <p class="page-subtitle">Your work placement dashboard</p>
    </div>

    @if (viewModel.HasConfirmedPlacements)
    {
        <div class="placements-grid">
            @foreach (var placement in viewModel.ConfirmedPlacements)
            {
                @await Html.PartialAsync("_CurrentPlacementWidget", placement)
            }
        </div>
    }
    else
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <rect x="8" y="2" width="8" height="4" rx="1"/>
                    <path d="M12 11v6"/>
                    <path d="M9 14h6"/>
                </svg>
            </div>
            <h3>No Active Placements</h3>
            <p>Once your placement is confirmed by your parent/guardian and employer, it will appear here.</p>
        </div>
    }

    @if (viewModel.HasPendingPlacements)
    {
        <h5 class="mb-3">Pending Placements</h5>
        <div class="details-container mb-4">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var placement in viewModel.PendingPlacements)
                        {
                            <tr>
                                <td>@(placement.Year?.ToString() ?? "N/A")</td>
                                <td>@(placement.CompanyName ?? "Not assigned")</td>
                                <td><span class="badge @placement.StatusDisplayClass">@placement.StatusDisplayText</span></td>
                                <td>
                                    <a asp-controller="Placements" asp-action="Details" asp-route-id="@placement.PlacementId" class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="quick-links-section">
        <h3 class="section-title">Quick Links</h3>
        <div class="quick-links-grid">
            <a href="/student/work-history/@viewModel.StudentId" class="quick-link-card">
                <div class="quick-link-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 8v4l3 3"/>
                        <circle cx="12" cy="12" r="10"/>
                    </svg>
                </div>
                <div class="quick-link-content">
                    <span class="quick-link-title">Work History</span>
                    <span class="quick-link-desc">Update your work experience record</span>
                </div>
                <svg class="quick-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </a>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <h1 class="page-title">Student Dashboard</h1>
        <p class="page-subtitle">Your work placement dashboard</p>
    </div>

    <div class="alert alert-warning">
        <p class="mb-0">Unable to load your dashboard. Please try refreshing the page or contact your administrator.</p>
    </div>
}
