@{
    ViewData["Title"] = "Account Not Linked";
}

<div class="page-header">
    <h1 class="page-title">Account Not Linked</h1>
</div>

<div class="details-container">
    <div class="alert alert-warning mb-4">
        <h5 class="alert-heading">Your account is not linked to a student record</h5>
        <p>Your user account has been created, but it hasn't been linked to a student profile in the system yet.</p>
        <hr>
        <p class="mb-0">Please contact your teacher or school administrator to have your account linked to your student record.</p>
    </div>

    <div class="text-center">
        <form asp-controller="Authentication" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary">
                Logout
            </button>
        </form>
    </div>
</div>
