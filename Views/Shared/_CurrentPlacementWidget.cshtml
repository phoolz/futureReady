@model Apiary.Models.StudentPortal.StudentPlacementViewModel

<div class="placement-hero">
    <div class="placement-hero-header">
        <div class="placement-hero-company">
            <div class="company-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                    <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                    <path d="M12 12v.01"/>
                    <path d="M2 12h20"/>
                </svg>
            </div>
            <div class="company-info">
                <h2 class="company-name">@(Model.CompanyName ?? "Your Placement")</h2>
                @if (!string.IsNullOrEmpty(Model.CompanyIndustry))
                {
                    <span class="company-industry">@Model.CompanyIndustry</span>
                }
            </div>
        </div>
        <span class="placement-status @(Model.StatusDisplayText?.ToLower() == "confirmed" ? "status-confirmed" : "")">
            <span class="status-dot"></span>
            @Model.StatusDisplayText
        </span>
    </div>

    <div class="placement-hero-stats">
        <div class="stat-hours">
            <div class="hours-ring">
                <span class="hours-value">@Model.TotalHoursWorked.ToString("0.#")</span>
                <span class="hours-label">hours</span>
            </div>
            <p class="hours-caption">Total time logged</p>
        </div>

        <div class="stat-details">
            @if (!string.IsNullOrEmpty(Model.WorkStartTime) || !string.IsNullOrEmpty(Model.WorkEndTime))
            {
                <div class="detail-item">
                    <div class="detail-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">Work Hours</span>
                        <span class="detail-value">@(Model.WorkStartTime ?? "—") – @(Model.WorkEndTime ?? "—")</span>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.DressRequirement))
            {
                <div class="detail-item">
                    <div class="detail-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
                        </svg>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">Dress Code</span>
                        <span class="detail-value">@Model.DressRequirement</span>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SupervisorFullName))
    {
        <div class="placement-hero-supervisor">
            <div class="supervisor-avatar">
                @(Model.SupervisorFullName?.Substring(0, 1).ToUpper())
            </div>
            <div class="supervisor-info">
                <span class="supervisor-name">@Model.SupervisorFullName</span>
                @if (!string.IsNullOrEmpty(Model.SupervisorJobTitle))
                {
                    <span class="supervisor-title">@Model.SupervisorJobTitle</span>
                }
            </div>
            <div class="supervisor-contact">
                @if (!string.IsNullOrEmpty(Model.SupervisorPhone))
                {
                    <a href="tel:@Model.SupervisorPhone" class="contact-btn" title="Call">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.SupervisorEmail))
                {
                    <a href="mailto:@Model.SupervisorEmail" class="contact-btn" title="Email">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </a>
                }
            </div>
        </div>
    }

    <div class="placement-hero-actions">
        <a href="/student/logbook/@Model.PlacementId" class="action-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Log Today's Hours
        </a>
        <a href="/LogbookEntries/@Model.PlacementId" class="action-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" x2="8" y1="13" y2="13"/>
                <line x1="16" x2="8" y1="17" y2="17"/>
                <line x1="10" x2="8" y1="9" y2="9"/>
            </svg>
            View Logbook
        </a>
        <a asp-controller="Placements" asp-action="Details" asp-route-id="@Model.PlacementId" class="action-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
            </svg>
            Details
        </a>
    </div>
</div>
