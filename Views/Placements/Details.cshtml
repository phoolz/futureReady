@using Apiary.Models
@using Apiary.Models.LogbookEntries
@model Apiary.Models.School.Placement
@{
    ViewData["Title"] = "Placement Details";
    var formTokens = ViewData["FormTokens"] as List<Apiary.Models.School.FormToken> ?? new List<Apiary.Models.School.FormToken>();
    var employerTokens = formTokens.Where(t => t.FormType == "employer_acceptance").ToList();
    var parentTokens = formTokens.Where(t => t.FormType == "parent_permission").ToList();
    var logbookData = ViewData["LogbookEntries"] as LogbookEntriesListViewModel;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Placement Details</h1>
    <div>
        @if (User.IsInRole(Roles.Teacher))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@if (User.IsInRole(Roles.Teacher))
{
    if (TempData["FormLink"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["FormLinkMessage"]</strong>
            <div class="mt-2">
                <input type="text" class="form-control" value="@TempData["FormLink"]" id="formLinkInput" readonly />
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-light" onclick="navigator.clipboard.writeText(document.getElementById('formLinkInput').value)">
                    <i class="bi bi-clipboard"></i> Copy to Clipboard
                </button>
                <a href="@TempData["FormLink"]" target="_blank" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-up-right"></i> Open In New Tab
                </a>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (TempData["ParentFormLink"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <strong>@TempData["ParentFormLinkMessage"]</strong>
            <div class="mt-2">
                <input type="text" class="form-control" value="@TempData["ParentFormLink"]" id="parentFormLinkInput" readonly />
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-light" onclick="navigator.clipboard.writeText(document.getElementById('parentFormLinkInput').value)">
                    <i class="bi bi-clipboard"></i> Copy to Clipboard
                </button>
                <a href="@TempData["ParentFormLink"]" target="_blank" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-up-right"></i> Open In New Tab
                </a>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Placement Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Student</dt>
                    <dd class="col-sm-8">
                        @if (Model.Student != null)
                        {
                            @Model.Student.FirstName @Model.Student.LastName
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">
                        @if (Model.Company != null)
                        {
                            @Model.Company.Name
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Supervisor</dt>
                    <dd class="col-sm-8">
                        @if (Model.Supervisor != null)
                        {
                            @Model.Supervisor.FirstName @Model.Supervisor.LastName
                            @if (!string.IsNullOrEmpty(Model.Supervisor.Email))
                            {
                                <span class="text-muted">(@Model.Supervisor.Email)</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Year</dt>
                    <dd class="col-sm-8">@Model.Year</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusClass = Model.Status switch
                            {
                                "confirmed" => "bg-success",
                                "pending_employer" => "bg-warning text-dark",
                                "pending_parent" => "bg-info",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                    </dd>
                </dl>
            </div>
        </div>

        @if (Model.DressRequirement != null || Model.WorkStartTime != null || Model.WorkEndTime != null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Work Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        @if (Model.WorkStartTime != null || Model.WorkEndTime != null)
                        {
                            <dt class="col-sm-4">Work Hours</dt>
                            <dd class="col-sm-8">@Model.WorkStartTime - @Model.WorkEndTime</dd>
                        }

                        @if (Model.DressRequirement != null)
                        {
                            <dt class="col-sm-4">Dress Requirement</dt>
                            <dd class="col-sm-8">@Model.DressRequirement</dd>
                        }
                    </dl>
                </div>
            </div>
        }

        @* Logbook Section - visible to both teachers and students *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Logbook Entries</h5>
                <div class="d-flex gap-2">
                    <a href="/LogbookEntries?placementId=@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-list-ul"></i> View Full Logbook
                    </a>
                    <a href="/student/logbook/@Model.Id" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle"></i> Add Entry
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (logbookData != null && logbookData.TotalEntries > 0)
                {
                    <div class="row mb-3">
                        <div class="col-md-4 text-center">
                            <div class="border rounded p-3">
                                <h4 class="mb-0">@logbookData.TotalHours.ToString("0.#")</h4>
                                <small class="text-muted">Total Hours</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border rounded p-3">
                                <h4 class="mb-0">@logbookData.VerifiedCount</h4>
                                <small class="text-muted">Verified</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border rounded p-3">
                                <h4 class="mb-0">@logbookData.TotalEntries</h4>
                                <small class="text-muted">Total Entries</small>
                            </div>
                        </div>
                    </div>

                    <h6>Recent Entries</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Start</th>
                                <th>Finish</th>
                                <th>Hours</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in logbookData.Entries)
                            {
                                <tr>
                                    <td>@entry.Date.ToString("d MMM yyyy")</td>
                                    <td>@entry.StartTime</td>
                                    <td>@entry.FinishTime</td>
                                    <td>@entry.TotalHoursWorked.ToString("0.#")</td>
                                    <td>
                                        @if (entry.SupervisorVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/student/logbook/@Model.Id/@entry.Date.ToString("yyyy-MM-dd")" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-journal-text fs-1 text-muted"></i>
                        <p class="text-muted mt-2">No logbook entries yet.</p>
                        <a href="/student/logbook/@Model.Id" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Add First Entry
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (User.IsInRole(Roles.Teacher))
        {
            var activeEmployerToken = employerTokens.FirstOrDefault(t => t.IsValid);
            var activeParentToken = parentTokens.FirstOrDefault(t => t.IsValid);

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Form Links</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Form Type</th>
                                <th>Status</th>
                                <th>Expires</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Employer Acceptance Row *@
                            <tr>
                                <td><strong>Employer Acceptance</strong></td>
                                <td>
                                    @if (Model.EmployerSubmittedAt.HasValue)
                                    {
                                        <span class="badge bg-success">Submitted @Model.EmployerSubmittedAt.Value.ToString("d MMM yyyy")</span>
                                    }
                                    else if (activeEmployerToken != null)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No active link</span>
                                    }
                                </td>
                                <td>
                                    @if (activeEmployerToken != null)
                                    {
                                        @activeEmployerToken.ExpiresAt.ToString("g")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (Model.EmployerSubmittedAt.HasValue)
                                        {
                                            <a asp-action="EmployerFormReview" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i> Review
                                            </a>
                                        }
                                        @if (activeEmployerToken != null)
                                        {
                                            <form asp-action="ResendEmployerForm" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="tokenId" value="@activeEmployerToken.Id" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm" title="Revoke and generate new link">
                                                    <i class="bi bi-arrow-repeat"></i> Resend
                                                </button>
                                            </form>
                                            <form asp-action="DeleteEmployerFormToken" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this form link?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="tokenId" value="@activeEmployerToken.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete link">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="SendEmployerForm" asp-route-id="@Model.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-link-45deg"></i> Generate Link
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @* Parent Permission Row *@
                            <tr>
                                <td><strong>Parent Permission</strong></td>
                                <td>
                                    @if (Model.ParentSubmittedAt.HasValue)
                                    {
                                        <span class="badge bg-success">Submitted @Model.ParentSubmittedAt.Value.ToString("d MMM yyyy")</span>
                                    }
                                    else if (activeParentToken != null)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No active link</span>
                                    }
                                </td>
                                <td>
                                    @if (activeParentToken != null)
                                    {
                                        @activeParentToken.ExpiresAt.ToString("g")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (activeParentToken != null)
                                        {
                                            <form asp-action="ResendParentForm" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="tokenId" value="@activeParentToken.Id" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm" title="Revoke and generate new link">
                                                    <i class="bi bi-arrow-repeat"></i> Resend
                                                </button>
                                            </form>
                                            <form asp-action="DeleteParentFormToken" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this form link?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="tokenId" value="@activeParentToken.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete link">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="SendParentForm" asp-route-id="@Model.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-link-45deg"></i> Generate Link
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
