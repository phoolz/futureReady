@model IEnumerable<Apiary.Models.School.Placement>

@{
    ViewData["Title"] = "Placements";
}

<div class="list-header">
    <div class="list-header-content">
        <h1>Placements</h1>
        <p>Manage student work experience placements</p>
    </div>
    <div class="list-header-actions">
        <div class="search-input">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Search placements..." onkeyup="filterTable()">
        </div>
        <a asp-action="Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add Placement
        </a>
    </div>
</div>

<div class="list-table">
    <table id="dataTable">
        <thead>
            <tr>
                <th>Students</th>
                <th>Company</th>
                <th>Supervisor</th>
                <th>Year</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var statusClass = item.Status switch
            {
                "confirmed" => "status-success",
                "pending_employer" => "status-warning",
                "pending_parent" => "status-info",
                "pending_parents" => "status-info",
                "partial" => "status-info",
                _ => "status-neutral"
            };
            var statusText = item.Status switch
            {
                "confirmed" => "Confirmed",
                "pending_employer" => "Pending Employer",
                "pending_parent" => "Pending Parent",
                "pending_parents" => "Pending Parents",
                "partial" => "Partial",
                _ => item.Status ?? "Draft"
            };

            var placementStudents = item.PlacementStudents?.Where(ps => !ps.IsDeleted).ToList() ?? new List<Apiary.Models.School.PlacementStudent>();
            var studentCount = placementStudents.Count;
            var studentNames = string.Empty;

            if (studentCount == 0)
            {
                studentNames = "No students assigned";
            }
            else if (studentCount == 1)
            {
                var student = placementStudents.First().Student;
                studentNames = student != null ? $"{student.FirstName} {student.LastName}" : "Unknown";
            }
            else if (studentCount == 2)
            {
                studentNames = string.Join(", ", placementStudents.Take(2).Select(ps => ps.Student?.FirstName ?? "Unknown"));
            }
            else
            {
                studentNames = string.Join(", ", placementStudents.Take(2).Select(ps => ps.Student?.FirstName ?? "Unknown")) + $" +{studentCount - 2} more";
            }

            <tr class="clickable" onclick="window.location='@Url.Action("Details", new { id = item.Id })'">
                <td class="cell-primary">
                    @if (studentCount > 0)
                    {
                        <span>@studentNames</span>
                        @if (studentCount > 1)
                        {
                            <span class="badge bg-secondary ms-1">@studentCount</span>
                        }
                    }
                    else
                    {
                        <span class="cell-secondary">No students</span>
                    }
                </td>
                <td>@(item.Company?.Name ?? "—")</td>
                <td class="cell-secondary">
                    @if (item.Supervisor != null)
                    {
                        @($"{item.Supervisor.FirstName} {item.Supervisor.LastName}")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td class="cell-secondary">@(item.Year?.ToString() ?? "—")</td>
                <td>
                    <span class="status-badge @statusClass">@statusText</span>
                </td>
                <td>
                    <div class="row-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="row-action action-view" title="View" onclick="event.stopPropagation()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="row-action action-edit" title="Edit" onclick="event.stopPropagation()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                            </svg>
                        </a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="list-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <rect x="8" y="2" width="8" height="4" rx="1"/>
            </svg>
            <p>No placements found. Create your first placement to get started.</p>
        </div>
    }
</div>

@section Scripts {
<script>
    function filterTable() {
        var input = document.getElementById("searchInput");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("dataTable");
        var rows = table.getElementsByTagName("tr");

        for (var i = 1; i < rows.length; i++) {
            var cells = rows[i].getElementsByTagName("td");
            var match = false;
            for (var j = 0; j < cells.length; j++) {
                if (cells[j].textContent.toLowerCase().indexOf(filter) > -1) {
                    match = true;
                    break;
                }
            }
            rows[i].style.display = match ? "" : "none";
        }
    }
</script>
}
