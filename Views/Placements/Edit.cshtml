@model Apiary.Models.School.Placement

@{
    ViewData["Title"] = "Edit Placement";
    var placementStudents = Model.PlacementStudents?.Where(ps => !ps.IsDeleted).ToList() ?? new List<Apiary.Models.School.PlacementStudent>();
}

<h1>Edit Placement</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RowVersion" />

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Placement Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Year" class="form-label"></label>
                            <input asp-for="Year" class="form-control" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="draft">Draft</option>
                                <option value="pending_employer">Pending Employer</option>
                                <option value="pending_parents">Pending Parents</option>
                                <option value="partial">Partial</option>
                                <option value="confirmed">Confirmed</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label asp-for="PlacementRole" class="form-label"></label>
                        <input asp-for="PlacementRole" class="form-control" placeholder="e.g., Retail Assistant, Office Admin" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyId" class="form-label">Company</label>
                            <select asp-for="CompanyId" asp-items="ViewBag.CompanyId" class="form-select">
                                <option value="">-- Select Company --</option>
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SupervisorId" class="form-label">Supervisor</label>
                            <select asp-for="SupervisorId" asp-items="ViewBag.SupervisorId" class="form-select">
                                <option value="">-- Select Supervisor --</option>
                            </select>
                            <span asp-validation-for="SupervisorId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Students</h5>
            </div>
            <div class="card-body">
                @if (placementStudents.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Parent Submitted</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ps in placementStudents)
                            {
                                var studentStatusClass = ps.Status switch
                                {
                                    "confirmed" => "bg-success",
                                    "pending_parent" => "bg-warning text-dark",
                                    "withdrawn" => "bg-secondary",
                                    _ => "bg-info"
                                };
                                var studentStatusText = ps.Status switch
                                {
                                    "confirmed" => "Confirmed",
                                    "pending_parent" => "Pending Parent",
                                    "withdrawn" => "Withdrawn",
                                    _ => ps.Status ?? "Unknown"
                                };
                                <tr>
                                    <td>@(ps.Student != null ? $"{ps.Student.FirstName} {ps.Student.LastName}" : "Unknown")</td>
                                    <td><span class="badge @studentStatusClass">@studentStatusText</span></td>
                                    <td>
                                        @if (ps.ParentSubmittedAt.HasValue)
                                        {
                                            @ps.ParentSubmittedAt.Value.ToString("d MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="RemoveStudent" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to remove this student from the placement?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="studentId" value="@ps.StudentId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove student">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No students assigned to this placement.</p>
                }

                <hr />

                <h6>Add Student</h6>
                <form asp-action="AddStudent" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-8">
                        <select name="studentId" class="form-select" required>
                            <option value="">-- Select Student --</option>
                            @if (ViewData["AvailableStudents"] is SelectList availableStudents)
                            {
                                @foreach (var item in availableStudents)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-lg"></i> Add Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
