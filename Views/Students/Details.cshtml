@model FutureReady.Models.School.Student

@{
    ViewData["Title"] = "Student Details";
    var placements = ViewData["Placements"] as List<FutureReady.Models.School.Placement> ?? new List<FutureReady.Models.School.Placement>();
    var accountTokens = ViewData["AccountTokens"] as List<FutureReady.Models.School.StudentAccountToken> ?? new List<FutureReady.Models.School.StudentAccountToken>();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1 class="page-title">Student Details</h1>
        <p class="page-subtitle">@Model.FullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

@if (TempData["ActivationLink"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["ActivationLinkMessage"]</strong>
        <div class="mt-2">
            <input type="text" class="form-control" value="@TempData["ActivationLink"]" id="activationLinkInput" readonly />
        </div>
        <div class="mt-2 d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="navigator.clipboard.writeText(document.getElementById('activationLinkInput').value)">
                <i class="bi bi-clipboard"></i> Copy to Clipboard
            </button>
            <a href="@TempData["ActivationLink"]" target="_blank" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-box-arrow-up-right"></i> Open In New Tab
            </a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="details-container">
    <h5 class="mb-3">Personal Information</h5>
    <dl class="row">
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Preferred Name</dt>
        <dd class="col-sm-9">@(Model.PreferredName ?? "N/A")</dd>

        <dt class="col-sm-3">Date of Birth</dt>
        <dd class="col-sm-9">@(Model.DateOfBirth?.ToString("d MMMM yyyy") ?? "N/A")</dd>

        <dt class="col-sm-3">Student Number</dt>
        <dd class="col-sm-9">@(Model.StudentNumber ?? "N/A")</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@(Model.Phone ?? "N/A")</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@(Model.Email ?? "N/A")</dd>
    </dl>

    <hr class="my-4" />

    <h5 class="mb-3">Academic Information</h5>
    <dl class="row">
        <dt class="col-sm-3">Student Type</dt>
        <dd class="col-sm-9">@(Model.StudentType ?? "N/A")</dd>

        <dt class="col-sm-3">Year Level</dt>
        <dd class="col-sm-9">@(Model.YearLevel ?? "N/A")</dd>

        <dt class="col-sm-3">Graduation Year</dt>
        <dd class="col-sm-9">@(Model.GraduationYear?.ToString() ?? "N/A")</dd>

        <dt class="col-sm-3">Medicare Number</dt>
        <dd class="col-sm-9">@(Model.MedicareNumber ?? "N/A")</dd>
    </dl>

    <hr class="my-4" />

    <h5 class="mb-3">Placements</h5>
    @if (placements.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Company</th>
                        <th>Supervisor</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var placement in placements)
                    {
                        var statusClass = placement.Status switch
                        {
                            "confirmed" => "bg-success",
                            "pending_employer" => "bg-warning text-dark",
                            "pending_parent" => "bg-info",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>@placement.Year</td>
                            <td>@(placement.Company?.Name ?? "Not assigned")</td>
                            <td>@(placement.Supervisor != null ? $"{placement.Supervisor.FirstName} {placement.Supervisor.LastName}" : "Not assigned")</td>
                            <td><span class="badge @statusClass">@placement.Status</span></td>
                            <td>
                                <a asp-controller="Placements" asp-action="Details" asp-route-id="@placement.Id" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No placements found for this student.</p>
    }
    <a asp-controller="Placements" asp-action="Create" class="btn btn-sm btn-success">
        <i class="bi bi-plus"></i> Add Placement
    </a>

    <hr class="my-4" />

    <h5 class="mb-3">Student Account</h5>
    @if (Model.UserId.HasValue)
    {
        <div class="alert alert-success mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <strong>Account Active</strong> - This student has a linked user account.
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Email))
    {
        <div class="alert alert-info mb-3">
            <i class="bi bi-info-circle-fill"></i>
            <strong>No Account</strong> - Generate an activation link to allow the student to create their account.
        </div>
        <form asp-action="GenerateActivationLink" asp-route-id="@Model.Id" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">
                <i class="bi bi-link-45deg"></i> Generate Activation Link
            </button>
        </form>
    }
    else
    {
        <div class="alert alert-warning mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Email Required</strong> - Add an email address to enable student account creation.
            <a asp-action="Edit" asp-route-id="@Model.Id" class="alert-link">Edit student</a>
        </div>
    }

    @if (accountTokens.Any())
    {
        <h6>Activation Link History</h6>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in accountTokens)
                {
                    var isActive = token.UsedAt == null && token.ExpiresAt > DateTime.UtcNow;
                    <tr>
                        <td>@token.CreatedAt.ToString("g")</td>
                        <td>@token.ExpiresAt.ToString("g")</td>
                        <td>
                            @if (token.UsedAt != null)
                            {
                                <span class="badge bg-success">Used @token.UsedAt.Value.ToString("g")</span>
                            }
                            else if (token.ExpiresAt <= DateTime.UtcNow)
                            {
                                <span class="badge bg-secondary">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                @if (isActive)
                                {
                                    <form asp-action="ResendActivationLink" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="tokenId" value="@token.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm" title="Revoke and generate new link">
                                            <i class="bi bi-arrow-repeat"></i> Resend
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteActivationToken" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this activation token?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="tokenId" value="@token.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete token">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr class="my-4" />

    <h5 class="mb-3">Related Information</h5>
    <div class="d-flex gap-2">
        <a asp-controller="EmergencyContacts" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            View Emergency Contacts
        </a>
        <a asp-controller="StudentMedicalConditions" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            View Medical Conditions
        </a>
        <a href="/student/work-history/@Model.Id" class="btn btn-outline-primary">
            View Work History
        </a>
    </div>

    </div>
