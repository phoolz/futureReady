@model Apiary.Models.School.Student

@{
    ViewData["Title"] = "Student Details";
    var placements = ViewData["Placements"] as List<Apiary.Models.School.Placement> ?? new List<Apiary.Models.School.Placement>();
    var accountTokens = ViewData["AccountTokens"] as List<Apiary.Models.School.StudentAccountToken> ?? new List<Apiary.Models.School.StudentAccountToken>();
    var placementSummaries = ViewData["PlacementSummaries"] as Dictionary<Guid, (decimal TotalHours, int EntryCount, int VerifiedCount, Guid? PlacementStudentId)>
        ?? new Dictionary<Guid, (decimal TotalHours, int EntryCount, int VerifiedCount, Guid? PlacementStudentId)>();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1 class="page-title">Student Details</h1>
        <p class="page-subtitle">@Model.FullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

@if (TempData["ActivationLink"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["ActivationLinkMessage"]</strong>
        <div class="mt-2">
            <input type="text" class="form-control" value="@TempData["ActivationLink"]" id="activationLinkInput" readonly />
        </div>
        <div class="mt-2 d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="navigator.clipboard.writeText(document.getElementById('activationLinkInput').value)">
                <i class="bi bi-clipboard"></i> Copy to Clipboard
            </button>
            <a href="@TempData["ActivationLink"]" target="_blank" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-box-arrow-up-right"></i> Open In New Tab
            </a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Personal & Academic Information Side-by-Side -->
<div class="row">
    <div class="col-md-6 d-flex">
        <div class="card mb-4 flex-fill">
            <div class="card-header">
                <h5 class="mb-0">Personal Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">First Name</dt>
                    <dd class="col-sm-7">@Model.FirstName</dd>

                    <dt class="col-sm-5">Last Name</dt>
                    <dd class="col-sm-7">@Model.LastName</dd>

                    <dt class="col-sm-5">Preferred Name</dt>
                    <dd class="col-sm-7">@(Model.PreferredName ?? "N/A")</dd>

                    <dt class="col-sm-5">Date of Birth</dt>
                    <dd class="col-sm-7">@(Model.DateOfBirth?.ToString("d MMMM yyyy") ?? "N/A")</dd>

                    <dt class="col-sm-5">Student Number</dt>
                    <dd class="col-sm-7">@(Model.StudentNumber ?? "N/A")</dd>

                    <dt class="col-sm-5">Phone</dt>
                    <dd class="col-sm-7">@(Model.Phone ?? "N/A")</dd>

                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@(Model.Email ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6 d-flex">
        <div class="card mb-4 flex-fill">
            <div class="card-header">
                <h5 class="mb-0">Academic Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Student Type</dt>
                    <dd class="col-sm-7">@(Model.StudentType ?? "N/A")</dd>

                    <dt class="col-sm-5">Year Level</dt>
                    <dd class="col-sm-7">@(Model.YearLevel ?? "N/A")</dd>

                    <dt class="col-sm-5">Graduation Year</dt>
                    <dd class="col-sm-7">@(Model.GraduationYear?.ToString() ?? "N/A")</dd>

                    <dt class="col-sm-5">Medicare Number</dt>
                    <dd class="col-sm-7">@(Model.MedicareNumber ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Placements Section -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Placements</h5>
        <a asp-controller="Placements" asp-action="Create" class="btn btn-sm btn-success">
            <i class="bi bi-plus"></i> Add Placement
        </a>
    </div>
    <div class="card-body">
        @if (placements.Any())
        {
            <div class="row">
                @foreach (var placement in placements)
                {
                    var statusClass = placement.Status switch
                    {
                        "confirmed" => "bg-success",
                        "pending_employer" => "bg-warning text-dark",
                        "pending_parent" => "bg-info",
                        _ => "bg-secondary"
                    };
                    var summary = placementSummaries.GetValueOrDefault(placement.Id);

                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="card-title mb-1">
                                            @(placement.PlacementRole ?? "No role specified")
                                        </h6>
                                        <p class="text-muted mb-0">
                                            @(placement.Company?.Name ?? "No company assigned")
                                        </p>
                                    </div>
                                    <span class="badge @statusClass">@placement.Status</span>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar"></i> @(placement.Year?.ToString() ?? "No year")
                                        @if (placement.Supervisor != null)
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-person"></i> @placement.Supervisor.FirstName @placement.Supervisor.LastName
                                            </span>
                                        }
                                    </small>
                                </div>

                                @if (summary.PlacementStudentId.HasValue)
                                {
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="text-center">
                                            <div class="fw-bold">@summary.TotalHours.ToString("0.#")</div>
                                            <small class="text-muted">Hours</small>
                                        </div>
                                        <div class="text-center">
                                            <div class="fw-bold">@summary.EntryCount</div>
                                            <small class="text-muted">Entries</small>
                                        </div>
                                        <div class="text-center">
                                            <div class="fw-bold">@summary.VerifiedCount</div>
                                            <small class="text-muted">Verified</small>
                                        </div>
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <a asp-controller="Placements" asp-action="Details" asp-route-id="@placement.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    @if (summary.PlacementStudentId.HasValue)
                                    {
                                        <a href="/logbook/@summary.PlacementStudentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-journal-text"></i> Logbook
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No placements found for this student.</p>
        }
    </div>
</div>

<!-- Student Account Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Student Account</h5>
    </div>
    <div class="card-body">
        @if (Model.UserId.HasValue)
        {
            <div class="alert alert-success mb-3">
                <i class="bi bi-check-circle-fill"></i>
                <strong>Account Active</strong> - This student has a linked user account.
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <div class="alert alert-info mb-3">
                <i class="bi bi-info-circle-fill"></i>
                <strong>No Account</strong> - Generate an activation link to allow the student to create their account.
            </div>
            <form asp-action="GenerateActivationLink" asp-route-id="@Model.Id" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-link-45deg"></i> Generate Activation Link
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-warning mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Email Required</strong> - Add an email address to enable student account creation.
                <a asp-action="Edit" asp-route-id="@Model.Id" class="alert-link">Edit student</a>
            </div>
        }

        @if (accountTokens.Any())
        {
            <h6>Activation Link History</h6>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var token in accountTokens)
                    {
                        var isActive = token.UsedAt == null && token.ExpiresAt > DateTime.UtcNow;
                        <tr>
                            <td>@token.CreatedAt.ToString("g")</td>
                            <td>@token.ExpiresAt.ToString("g")</td>
                            <td>
                                @if (token.UsedAt != null)
                                {
                                    <span class="badge bg-success">Used @token.UsedAt.Value.ToString("g")</span>
                                }
                                else if (token.ExpiresAt <= DateTime.UtcNow)
                                {
                                    <span class="badge bg-secondary">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    @if (isActive)
                                    {
                                        <form asp-action="ResendActivationLink" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="tokenId" value="@token.Id" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm" title="Revoke and generate new link">
                                                <i class="bi bi-arrow-repeat"></i> Resend
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="DeleteActivationToken" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this activation token?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="tokenId" value="@token.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete token">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Related Information -->
<div class="d-flex gap-2 mb-4">
    <a asp-controller="EmergencyContacts" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-telephone"></i> Emergency Contacts
    </a>
    <a asp-controller="StudentMedicalConditions" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-heart-pulse"></i> Medical Conditions
    </a>
    <a href="/student/work-history/@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-briefcase"></i> Work History
    </a>
</div>
