@model Apiary.Models.LogbookEntries.LogbookEntriesListViewModel

@{
    ViewData["Title"] = "Logbook Entries";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Logbook Entries</h1>
        <p class="text-muted mb-0">@Model.PlacementInfo</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/student/logbook/@Model.PlacementId" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Entry
        </a>
        <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-primary">@Model.TotalHours.ToString("0.#")</div>
                <div class="text-muted">Total Hours</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-success">@Model.VerifiedCount</div>
                <div class="text-muted">Verified Entries</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalEntries</div>
                <div class="text-muted">Total Entries</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Entries.Any())
        {
            <table class="table table-striped table-hover" id="dataTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Hours</th>
                        <th>Cumulative</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr onclick="window.location='/student/logbook/@Model.PlacementId/@entry.Date.ToString("yyyy-MM-dd")'" style="cursor: pointer;">
                            <td>@entry.Date.ToString("ddd, d MMM yyyy")</td>
                            <td>@(entry.StartTime ?? "-")</td>
                            <td>@(entry.FinishTime ?? "-")</td>
                            <td>@entry.TotalHoursWorked.ToString("0.#")</td>
                            <td>@entry.CumulativeHours.ToString("0.#")</td>
                            <td>
                                @if (entry.SupervisorVerified)
                                {
                                    <span class="badge bg-success">Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-text display-4 text-muted"></i>
                <h5 class="mt-3">No logbook entries yet</h5>
                <p class="text-muted">Start logging your work placement hours by adding your first entry.</p>
                <a href="/student/logbook/@Model.PlacementId" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add First Entry
                </a>
            </div>
        }
    </div>
</div>
